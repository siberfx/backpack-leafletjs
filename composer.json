{
    "name": "siberfx/backpack-leafletjs",
    "description": "Leaflet.js map field and Blade component for Laravel Backpack — pick, search and store latitude/longitude with OpenStreetMap or Mapbox tiles.",
    "keywords": [
        "laravel",
        "laravel-12",
        "laravel-13",
        "backpack",
        "backpack-for-laravel",
        "leaflet",
        "leafletjs",
        "openstreetmap",
        "mapbox",
        "geocoding"
    ],
    "homepage": "https://github.com/siberfx/backpack-leafletjs",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Selim Görmüş",
            "email": "info@siberfx.com",
            "role": "Fullstack Software Engineer"
        }
    ],
    "support": {
        "issues": "https://github.com/siberfx/backpack-leafletjs/issues",
        "source": "https://github.com/siberfx/backpack-leafletjs"
    },
    "require": {
        "php": "^8.2",
        "backpack/crud": "^6.8|^7.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Siberfx\\Leafletjs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Siberfx\\Leafletjs\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Siberfx\\Leafletjs\\LeafletServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
